<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 基础主题：白底 + 深色系统栏图标，与站点底色 #FFFFFF 一致，冷启动后不闪色 -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/jechan_accent</item>
        <item name="colorPrimaryDark">@color/jechan_splash</item>
        <item name="colorAccent">@color/jechan_accent</item>
        <item name="android:windowBackground">@color/jechan_bg</item>
        <item name="android:statusBarColor">@color/jechan_bg</item>
        <item name="android:navigationBarColor">@color/jechan_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- 沉浸：状态栏/导航栏与 H5 页面底色同为白色，图标用深色 -->
        <item name="android:windowBackground">@color/jechan_bg</item>
        <item name="android:statusBarColor">@color/jechan_bg</item>
        <item name="android:navigationBarColor">@color/jechan_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- 启动主题：Android 12+ 走 SplashScreen API，低版本由 core-splashscreen 兼容。底色用品牌蓝，便于白标呈现 -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/jechan_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/jechan_mark</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@color/jechan_splash</item>
    </style>
</resources>
