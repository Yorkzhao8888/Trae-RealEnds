page { height: 100%; background: #FFFFFF; }

.page {
  min-height: 100vh;
  padding: 48rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.head { display: flex; justify-content: center; margin: 20rpx 0 40rpx; }
.logo { width: 420rpx; display: block; }

.title { font-size: 44rpx; font-weight: 700; color: #0B1220; }
.tip { font-size: 26rpx; color: #7B8AA0; margin: 12rpx 0 36rpx; }

.grid { display: flex; flex-direction: column; gap: 20rpx; }

.card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx 32rpx;
  border: 1rpx solid #E4E9F2;
  border-radius: 28rpx;
  background: #F6F9FD;
}
.card:active { background: #EAF2FF; }

.ico {
  width: 80rpx; height: 80rpx; border-radius: 22rpx;
  background: #FFFFFF; border: 1rpx solid #E4E9F2;
  color: #1F6FEB; font-size: 34rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex: 0 0 auto;
}

.txt { flex: 1; min-width: 0; }
.name { font-size: 31rpx; font-weight: 600; color: #0B1220; }
.sub { font-size: 25rpx; color: #7B8AA0; margin-top: 6rpx; }

.arrow { color: #7B8AA0; font-size: 34rpx; }

.foot { margin-top: auto; padding-top: 48rpx; text-align: center; color: #7B8AA0; font-size: 24rpx; letter-spacing: 1rpx; }
