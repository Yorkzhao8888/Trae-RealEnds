.wrap {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 72rpx;
  background: #0F1115;
}

/* 用纯 CSS 画一个断开的双环，呼应品牌标记，不额外引入图片 */
.ring {
  width: 116rpx;
  height: 116rpx;
  border: 14rpx solid rgba(47, 129, 247, 0.38);
  border-right-color: transparent;
  border-radius: 50%;
  margin-bottom: 44rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #E6EDF3;
}

.desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #8B949E;
  text-align: center;
}

.reason {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #5B6472;
  word-break: break-all;
  text-align: center;
}

.btn {
  margin-top: 48rpx;
  width: 420rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  background: #2F81F7;
  color: #FFFFFF;
}

.btn.ghost {
  margin-top: 20rpx;
  background: transparent;
  color: #8B949E;
  border: 1rpx solid rgba(139, 148, 158, 0.35);
}

.btn-hover {
  opacity: 0.82;
}
