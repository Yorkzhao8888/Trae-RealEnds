.brand {
  position: fixed;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #0A2456;
  transition: opacity 240ms ease;
}

/* web-view 挂载后启动层淡出，不抢焦点 */
.brand-leave {
  opacity: 0;
  pointer-events: none;
}

.logo {
  width: 148rpx;
  height: 148rpx;
  margin-bottom: 24rpx;
}

.name {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #FFFFFF;
}

.slogan {
  margin-top: 12rpx;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: rgba(255, 255, 255, 0.68);
}
