.brand {
  position: fixed;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #0A2456;
  transition: opacity 240ms ease;
}

/* web-view 挂载后启动层淡出，不抢焦点 */
.brand-leave {
  opacity: 0;
  pointer-events: none;
}

/* 白卡片承载商标原色字标，避免藏青字标落在藏青底上不可见 */
.logo-card {
  width: 600rpx;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.18);
}

.logo {
  width: 100%;
  display: block;
}
