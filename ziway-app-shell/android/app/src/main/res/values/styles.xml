<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 基础主题：橙底 + 浅色系统栏图标，冷启动首帧即为品牌底色，不闪白 -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ziway_accent</item>
        <item name="colorPrimaryDark">@color/ziway_bg</item>
        <item name="colorAccent">@color/ziway_accent</item>
        <item name="android:windowBackground">@color/ziway_bg</item>
        <item name="android:statusBarColor">@color/ziway_bg</item>
        <item name="android:navigationBarColor">@color/ziway_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- 沉浸：状态栏/导航栏与 H5 品牌色同色，图标保持浅色 -->
        <item name="android:windowBackground">@color/ziway_bg</item>
        <item name="android:statusBarColor">@color/ziway_bg</item>
        <item name="android:navigationBarColor">@color/ziway_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- 启动主题：Android 12+ 走 SplashScreen API，低版本由 core-splashscreen 兼容。底色用品牌橙，与图标同色 -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ziway_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ziwayos_mark</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@color/ziway_splash</item>
    </style>
</resources>
