.wrap {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 72rpx;
  background: #F97316;
}

/* 用纯 CSS 画一个断开的双环，呼应品牌标记，不额外引入图片 */
.ring {
  width: 116rpx;
  height: 116rpx;
  border: 14rpx solid rgba(255, 255, 255, 0.55);
  border-right-color: transparent;
  border-radius: 50%;
  margin-bottom: 44rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #FFEDD5;
  text-align: center;
}

.reason {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #FFF7ED;
  word-break: break-all;
  text-align: center;
}

/* 橙底上主按钮改白底橙字，保证对比度 */
.btn {
  margin-top: 48rpx;
  width: 420rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  background: #FFFFFF;
  color: #F97316;
  font-weight: 600;
}

.btn.ghost {
  margin-top: 20rpx;
  background: transparent;
  color: #FFEDD5;
  font-weight: 400;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
}

.btn-hover {
  opacity: 0.82;
}
