{
  "name": "uendos-sdk",
  "version": "0.3.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "uendos-sdk",
      "version": "0.3.0",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=18"
      }
    },
    "node_modules/@uendos/conformance": {
      "resolved": "packages/conformance",
      "link": true
    },
    "node_modules/@uendos/contract": {
      "resolved": "packages/contract",
      "link": true
    },
    "node_modules/@uendos/shell": {
      "resolved": "packages/shell",
      "link": true
    },
    "node_modules/uendos": {
      "resolved": "packages/cli",
      "link": true
    },
    "packages/cli": {
      "name": "uendos",
      "version": "0.3.0",
      "bin": {
        "uendos": "bin/uendos.mjs"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "packages/conformance": {
      "name": "@uendos/conformance",
      "version": "0.3.0",
      "bin": {
        "uendos-conformance": "bin/conformance.mjs"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "packages/contract": {
      "name": "@uendos/contract",
      "version": "0.3.0",
      "engines": {
        "node": ">=18"
      }
    },
    "packages/shell": {
      "name": "@uendos/shell",
      "version": "0.3.0",
      "engines": {
        "node": ">=18"
      }
    }
  }
}
