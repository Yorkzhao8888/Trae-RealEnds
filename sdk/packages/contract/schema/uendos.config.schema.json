{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uendos.local/schema/uendos.config.schema.json",
  "title": "UendOS 壳工程配置",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "brand", "displayName", "alias", "accent", "endKey", "ends", "targets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "brand": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,15}$" },
    "displayName": { "type": "string", "minLength": 1 },
    "alias": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{1,15}$" },
    "prefix": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,15}$" },
    "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "statusBarStyle": { "enum": ["dark", "light"] },
    "endKey": { "type": "string", "minLength": 1 },
    "contractVersion": { "type": "string", "pattern": "^0\\.(3|4)(\\.[0-9]+)?$" },
    "launchMode": { "enum": ["portal", "launcher"] },
    "profile": { "enum": ["lite", "standard", "pro"] },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["light", "dark"] },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "bg": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "surface": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "ink": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "inkMuted": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "line": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "radius": { "type": "number", "minimum": 0, "maximum": 28 },
            "fontScale": { "type": "number", "minimum": 0.9, "maximum": 1.2 }
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["app", "pc", "mp", "web"] }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "rememberLast": { "type": "boolean" },
        "order": { "type": "array", "items": { "type": "string" } },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "ends"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "ends": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "ends": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z]{2,4}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
        }
      }
    },
    "packageId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)+$" },
    "caps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9.-]*$" }
        }
      }
    },
    "plugins": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "store": {
      "type": "object",
      "properties": {
        "manifest": { "type": "string" },
        "downloadDir": { "type": "string" },
        "api": { "type": "string" }
      }
    },
    "edge": {
      "type": "object",
      "properties": {
        "baseUrl": { "type": "string" },
        "timeoutMs": { "type": "integer", "minimum": 500, "maximum": 30000 }
      }
    }
  }
}
