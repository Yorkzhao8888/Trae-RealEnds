{
  "appId": "{{appId}}",
  "appName": "{{displayName}}",
  "webDir": "dist",
  "server": {
    "url": "{{primaryEndUrl}}",
    "errorPath": "offline.html",
    "cleartext": false,
    "allowNavigation": [{{allowHosts}}]
  },
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "never"
  }
}
