{
  "appId": "com.cewaycloud.cajob",
  "appName": "Cajob",
  "webDir": "dist",
  "server": {
    "url": "https://cajob.cewaysoft.com",
    "cleartext": false,
    "errorPath": "offline.html",
    "allowNavigation": [
      "cajob.cewaysoft.com",
      "oas.cewaysoft.com",
      "*.cewaysoft.com"
    ]
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "Keyboard": {
      "resize": "native"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0F1115",
      "overlaysWebView": false
    },
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "launchFadeOutDuration": 260,
      "backgroundColor": "#0A2456",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "contentInset": "never",
    "scrollEnabled": true,
    "webContentsDebuggingEnabled": false,
    "preferredContentMode": "mobile"
  }
}
